{
	"name": "ouorz-mono",
	"version": "0.0.2",
	"private": true,
	"description": "Monorepo for Tony's Personal Website and Related Projects",
	"license": "GPL-3.0-or-later",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "turbo run dev --parallel",
		"dev:main": "turbo run dev --filter=@ouorz/main",
		"dev:preview": "turbo run dev --filter=@ouorz/preview",
		"dev:test:main": "turbo run dev:test --filter=@ouorz/main",
		"dev:analytics": "turbo run dev --filter=@ouorz/analytics",
		"dev:twilight": "turbo run dev --parallel --filter=./packages/twilight-*",
		"dev:twilight:ui": "turbo run dev --filter=@twilight-toolkit/ui",
		"dev:twilight:utils": "turbo run dev --filter=@twilight-toolkit/utils",
		"lint": "oxlint",
		"lint:main": "oxlint apps/main",
		"lint:preview": "oxlint apps/preview",
		"lint:twilight": "oxlint packages",
		"lint:fix": "oxlint --fix",
		"lint:sol": "turbo run lint --filter=@ouorz/twilight-protocol",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"format:sol": "prettier --write \"packages/twilight-protocol/contracts/**/*.sol\"",
		"check": "oxlint && oxfmt --check",
		"test": "turbo run test",
		"test:main": "turbo run test --filter=@ouorz/main",
		"build": "turbo run build",
		"build:main": "turbo run @ouorz/main#build",
		"build:preview": "turbo run @ouorz/preview#build",
		"build:analytics": "turbo run @ouorz/analytics#build",
		"build:twilight": "turbo run build --filter=./packages/twilight-*",
		"build:twilight:ui": "turbo run @twilight-toolkit/ui#build",
		"build:twilight:ui:storybook": "turbo run @twilight-toolkit/ui#build:storybook",
		"build:twilight:utils": "turbo run build --filter=@twilight-toolkit/utils",
		"start": "turbo run start --parallel",
		"start:main": "turbo run start --filter=@ouorz/main",
		"start:analytics": "turbo run start --filter=@ouorz/analytics",
		"start:twilight:ui:storybook": "turbo run @twilight-toolkit/ui#start:storybook",
		"upgrade:root": "ncu -u && bun install",
		"upgrade:dev": "turbo run upgrade --parallel --filter=./apps/* && bun install",
		"upgrade:dev:analytics": "turbo run upgrade --parallel --filter=@ouorz/analytics && bun install",
		"upgrade:dev:main": "turbo run upgrade --filter=@ouorz/main && bun install",
		"upgrade:dev:preview": "turbo run upgrade --filter=@ouorz/preview && bun install",
		"upgrade:dev:twilight:ui": "turbo run upgrade --filter=@twilight-toolkit/ui && bun install",
		"clean": "turbo run clean --parallel && rm -rf node_modules"
	},
	"dependencies": {
		"re2js": "2.8.8"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@ethereumjs/util": "^10.1.3",
		"@oxlint/plugins": "1.80.0",
		"ethereum-cryptography": "^3.2.0",
		"lefthook": "^2.2.2",
		"npm-check-updates": "^23.1.1",
		"oxfmt": "0.65.0",
		"oxlint": "1.80.0",
		"oxlint-tsgolint": "7.0.2001",
		"prettier": "^3.9.10",
		"prettier-plugin-solidity": "^2.4.1",
		"solhint": "^6.2.5",
		"solhint-plugin-prettier": "^0.1.0",
		"turbo": "^2.11.9"
	},
	"overrides": {
		"@better-auth/api-key": {
			"better-call": "1.4.2"
		},
		"@better-auth/passkey": "1.7.10",
		"@neondatabase/neon-js": "0.8.0-beta",
		"@openzeppelin/hardhat-upgrades": "4.1.0",
		"@openzeppelin/upgrades-core": "1.46.0",
		"@xmldom/xmldom": "0.9.12",
		"better-auth": "1.7.10",
		"braces": "3.0.3",
		"d3-color": "3.1.0",
		"esbuild": "0.28.2",
		"gray-matter": "4.0.3",
		"js-yaml": "4.3.2",
		"katex": "0.18.11",
		"postcss": "8.5.30",
		"postcss-selector-parser": "7.1.6",
		"showdown": "2.1.0",
		"tinypool": "2.2.0",
		"uuid": "11.1.1",
		"webpack-dev-middleware": "7.4.5"
	},
	"engines": {
		"bun": ">=1.4.2",
		"node": "^22.22.2 || ^24.15.0 || >=26.0.0"
	},
	"packageManager": "bun@1.4.2",
	"patchedDependencies": {
		"gray-matter@4.0.3": "patches/gray-matter@4.0.3.patch",
		"showdown@2.1.0": "patches/showdown@2.1.0.patch",
		"braces@3.0.3": "patches/braces@3.0.3.patch",
		"@openzeppelin/upgrades-core@1.46.0": "patches/@openzeppelin%2Fupgrades-core@1.46.0.patch",
		"@openzeppelin/hardhat-upgrades@4.1.0": "patches/@openzeppelin%2Fhardhat-upgrades@4.1.0.patch",
		"next@16.4.2": "patches/next@16.4.2.patch",
		"nexment@0.1.1": "patches/nexment@0.1.1.patch"
	},
	"trustedDependencies": [
		"@prisma/client",
		"@prisma/engines",
		"@sentry-internal/node-cpu-profiler",
		"@swc/core",
		"@tailwindcss/oxide",
		"core-js",
		"core-js-pure",
		"cpu-features",
		"cypress",
		"esbuild",
		"keccak",
		"lefthook",
		"prisma",
		"secp256k1",
		"sharp",
		"ssh2"
	]
}
