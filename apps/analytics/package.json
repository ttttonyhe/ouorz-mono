{
	"name": "@ouorz/analytics",
	"version": "0.0.1",
	"description": "My personal analytics service powered by Umami",
	"license": "MIT",
	"homepage": "https://analytics.ouorz.com",
	"scripts": {
		"dev": "next dev -p 4444",
		"build": "run-s build-tracker build-lang build-geo build-db build-app",
		"start": "next start",
		"start-env": "node -r dotenv/config scripts/start-env.js",
		"build-app": "next build",
		"build-tracker": "bun build tracker/index.js --outfile public/analytics.js --format iife --minify --target browser",
		"build-db": "run-s copy-db-schema build-db-client",
		"build-lang": "run-s check-lang format-lang compile-lang",
		"build-geo": "node scripts/build-geo.js",
		"build-db-schema": "node scripts/prisma.js db pull",
		"build-db-client": "node scripts/prisma.js generate",
		"build-mysql-schema": "node scripts/prisma.js db pull --schema=./prisma/schema.mysql.prisma",
		"build-mysql-client": "node scripts/prisma.js generate --schema=./prisma/schema.mysql.prisma",
		"build-postgresql-schema": "node scripts/prisma.js db pull --schema=./prisma/schema.postgresql.prisma",
		"build-postgresql-client": "node scripts/prisma.js generate --schema=./prisma/schema.postgresql.prisma",
		"copy-db-schema": "node scripts/copy-db-schema.js",
		"generate-lang": "run-s extract-lang merge-lang",
		"extract-lang": "formatjs extract \"{pages,components}/**/*.js\" --out-file build/messages.json",
		"merge-lang": "node scripts/merge-lang.js",
		"format-lang": "node scripts/format-lang.js",
		"compile-lang": "formatjs compile-folder --ast build public/intl/messages",
		"check-lang": "node scripts/check-lang.js",
		"download-country-names": "node scripts/download-country-names.js",
		"download-language-names": "node scripts/download-language-names.js",
		"change-password": "node scripts/change-password.js",
		"clean": "rm -rf dist && rm -rf node_modules && rm -rf .turbo && rm -rf .next",
		"upgrade": "ncu --upgrade"
	},
	"dependencies": {
		"@fontsource/inter": "^5.3.0",
		"@prisma/adapter-mariadb": "7.10.1",
		"@prisma/adapter-pg": "7.10.1",
		"@prisma/client": "7.10.1",
		"@react-spring/web": "^10.0.4",
		"bcryptjs": "^3.0.3",
		"chart.js": "^4.6.1",
		"chartjs-adapter-date-fns": "^3.0.0",
		"classnames": "^2.5.1",
		"colord": "^2.14.0",
		"cors": "^2.8.6",
		"d3-geo": "^3.1.2",
		"date-fns": "^4.4.0",
		"detect-browser": "^5.3.0",
		"dotenv": "^18.0.10",
		"formik": "^2.4.9",
		"ipaddr.js": "^2.5.0",
		"is-localhost-ip": "^3.0.1",
		"isbot": "^5.2.3",
		"jose": "^6.2.18",
		"mariadb": "^3.5.5",
		"maxmind": "^5.1.0",
		"moment-timezone": "^0.6.6",
		"next": "16.4.6",
		"npm-run-all2": "^9.1.0",
		"pg": "^8.23.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-intl": "^12.2.0",
		"react-tooltip": "^6.0.13",
		"react-window": "^2.5.3",
		"request-ip": "^3.3.0",
		"thenby": "^1.4.1",
		"timezone-support": "^3.1.0",
		"uuid": "^11.1.1",
		"zustand": "^5.1.0"
	},
	"devDependencies": {
		"@formatjs/cli": "^6.20.0",
		"@svgr/webpack": "^8.1.0",
		"postcss": "^8.5.33",
		"postcss-flexbugs-fixes": "^5.0.2",
		"postcss-preset-env": "^11.6.3",
		"postcss-rtlcss": "^6.0.0",
		"prisma": "7.10.1",
		"prompts": "^2.4.2",
		"tar": "^7.5.23"
	}
}
