{
	"compilerOptions": {
		"target": "esnext",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"allowImportingTsExtensions": true,
		"jsx": "react-jsx",
		"paths": {
			"~/*": ["./src/*"],
			"react": ["./node_modules/@types/react"],
			"@twilight-toolkit/ui": ["../../packages/twilight-ui/src/index"],
			"@twilight-toolkit/utils": ["../../packages/twilight-utils/src/index"]
		},
		"incremental": true
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.mts",
		"**/*.tsx",
		"next.config.js",
		"tailwind.config.mjs"
	],
	"exclude": ["node_modules", "cypress"]
}
