{
	"$schema": "https://turborepo.org/schema.json",
	"ui": "stream",
	"globalDependencies": [
		".env.*",
		".oxlintrc.jsonc",
		".oxfmtrc.json",
		".solhint.json",
		".solhintignore",
		".prettierrc.mjs",
		"patches/*.patch"
	],
	"remoteCache": {
		"signature": true
	},
	"tasks": {
		"build": {
			"outputs": ["dist/**", ".next/**"],
			"dependsOn": ["^build"]
		},
		"@twilight-toolkit/utils#build": {
			"outputs": ["dist/**"]
		},
		"@ouorz/twilight-protocol#build": {
			"outputs": ["dist/**", "artifacts/**", "cache/**"]
		},
		"@twilight-toolkit/ui#build:storybook": {
			"outputs": ["storybook-static/**"],
			"dependsOn": ["@twilight-toolkit/utils#build"]
		},
		"@ouorz/main#build": {
			"dependsOn": ["^build"],
			"outputs": [".next/**"],
			"env": [
				"REVALIDATION_REQUEST_TOKEN",
				"SENTRY_ORG",
				"SENTRY_PROJECT",
				"SENTRY_AUTH_TOKEN",
				"SENTRY_IGNORE_API_RESOLUTION_ERROR",
				"NEXT_PUBLIC_SENTRY_DSN",
				"NEXT_PUBLIC_LC_KEY",
				"NEXT_PUBLIC_LC_ID",
				"JMS_API_PATH",
				"GITHUB_TOKEN",
				"ALCHEMY_API_PATH",
				"QUICK_NODE_API_PATH",
				"NEXT_PUBLIC_HOST_URL",
				"ANALYTICS_START_TIME",
				"ANALYTICS_TOKEN",
				"SPOTIFY_REFRESH_TOKEN",
				"TWITTER_BEARER_TOKEN",
				"OPENAI_API_KEY",
				"ALGOLIA_APP_ID",
				"ALGOLIA_API_KEY",
				"ALGOLIA_INDEX_NAME"
			]
		},
		"@ouorz/preview#build": {
			"dependsOn": ["^build"],
			"outputs": [".next/**"]
		},
		"@ouorz/analytics#build": {
			"dependsOn": ["^build"],
			"cache": false,
			"outputs": [
				".next/**",
				"public/analytics.js",
				"public/geo/**",
				"prisma/schema.prisma"
			],
			"env": [
				"DATABASE_TYPE",
				"DATABASE_URL",
				"DATABASE_DIRECT_URL",
				"DATABASE_POOLING_URL",
				"HASH_SALT",
				"BASE_PATH"
			]
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"start": {
			"dependsOn": ["^build"],
			"cache": false,
			"passThroughEnv": ["*"],
			"outputs": [],
			"persistent": true
		},
		"@twilight-toolkit/ui#start:storybook": {
			"dependsOn": ["^build"],
			"cache": false,
			"passThroughEnv": ["*"],
			"persistent": true
		},
		"dev": {
			"cache": false,
			"passThroughEnv": ["*"],
			"persistent": true
		},
		"dev:test": {
			"cache": false,
			"passThroughEnv": ["*"],
			"persistent": true
		},
		"clean": {
			"cache": false
		},
		"upgrade": {
			"outputs": ["package.json"]
		},
		"lint": {
			"outputs": []
		}
	}
}
