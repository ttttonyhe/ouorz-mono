{
	"name": "@twilight-toolkit/ui",
	"version": "0.0.2",
	"description": "A super opinionated UI library for React & Tailwind CSS",
	"license": "SEE LICENSE IN LICENSE",
	"files": [
		"/dist",
		"LICENSE",
		"README.md",
		"/styles"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"scripts": {
		"dev": "storybook dev -p 6006 --quiet",
		"build:storybook": "storybook build",
		"start:storybook": "http-server -s -p 5555 ./storybook-static",
		"clean": "rm -rf dist && rm -rf node_modules && rm -rf .turbo",
		"upgrade": "ncu --upgrade",
		"build": "tsup src/index.ts --format cjs,esm --clean && tsc -p tsconfig.build.json"
	},
	"dependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@storybook/addon-docs": "^10.6.2",
		"@storybook/addon-links": "^10.6.2",
		"@storybook/addon-styling-webpack": "^3.0.2",
		"@storybook/addon-themes": "^10.6.2",
		"@storybook/addon-webpack5-compiler-swc": "^4.0.3",
		"@storybook/react-webpack5": "^10.6.2",
		"@tailwindcss/typography": "^0.5.20",
		"@twilight-toolkit/utils": "workspace:*",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"autoprefixer": "^10.6.1",
		"css-loader": "^7.1.5",
		"esbuild": "^0.28.2",
		"esbuild-plugin-d.ts": "^2.0.1",
		"esbuild-sass-plugin": "^3.7.0",
		"http-server": "^14.1.1",
		"postcss": "^8.5.30",
		"postcss-loader": "^8.2.1",
		"react-docgen-typescript-plugin": "^1.0.8",
		"storybook": "^10.6.2",
		"storybook-dark-mode": "^5.0.0",
		"style-loader": "^4.0.0",
		"tailwindcss": "^4.3.3",
		"tsconfig-paths-webpack-plugin": "^4.2.0",
		"tsup": "^8.5.1",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"util": "^0.12.5",
		"webpack": "^5.112.0"
	}
}
