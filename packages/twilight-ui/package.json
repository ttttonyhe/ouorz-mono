{
	"name": "@twilight-toolkit/ui",
	"version": "0.0.2",
	"description": "A super opinionated UI library for React & Tailwind CSS",
	"license": "SEE LICENSE IN LICENSE",
	"files": [
		"/dist",
		"LICENSE",
		"README.md",
		"/styles"
	],
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		},
		"./styles/*": "./styles/*"
	},
	"scripts": {
		"dev": "storybook dev -p 6006 --quiet",
		"build:storybook": "storybook build",
		"start:storybook": "http-server -s -p 5555 ./storybook-static",
		"clean": "rm -rf dist && rm -rf node_modules && rm -rf .turbo",
		"upgrade": "ncu --upgrade",
		"build": "tsup src/index.ts --format cjs,esm --clean && tsc -p tsconfig.build.json"
	},
	"dependencies": {
		"@twilight-toolkit/utils": "workspace:*"
	},
	"devDependencies": {
		"@storybook/addon-docs": "^10.6.8",
		"@storybook/addon-links": "^10.6.8",
		"@storybook/addon-styling-webpack": "^3.0.3",
		"@storybook/addon-themes": "^10.6.8",
		"@storybook/addon-webpack5-compiler-swc": "^4.0.6",
		"@storybook/react-webpack5": "^10.6.8",
		"@tailwindcss/postcss": "^4.3.5",
		"@tailwindcss/typography": "^0.5.20",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"css-loader": "^7.1.5",
		"http-server": "^14.1.1",
		"postcss": "^8.5.33",
		"postcss-loader": "^8.2.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"storybook": "^10.6.8",
		"storybook-dark-mode": "^5.0.0",
		"style-loader": "^4.0.0",
		"tailwindcss": "^4.3.5",
		"tsconfig-paths-webpack-plugin": "^4.2.0",
		"tsup": "^9.0.0",
		"typescript": "^7.0.2",
		"webpack": "^5.113.0"
	},
	"peerDependencies": {
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	}
}
